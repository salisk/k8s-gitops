{
  "uid": "divegrade",
  "title": "DiveGrade",
  "description": "Dispatcher health, retained scheduler/media history, aggregate video frame progress and sampled worker resources. Namespace media; no job or asset IDs.",
  "tags": [
    "media",
    "divegrade"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape up",
      "type": "stat",
      "description": "1 = successful scrape; 0 = failed. No data can mean the target is undiscovered, not healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{namespace=\"media\",service=\"divegrade\",endpoint=\"http\"}",
          "legendFormat": "Scrape up",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Build version",
      "type": "stat",
      "description": "Dispatcher build version; value 1 identifies the reported version.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "divegrade_build_info{namespace=\"media\"}",
          "legendFormat": "{{version}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "name",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Scheduler healthy",
      "type": "stat",
      "description": "1 when the last dispatch succeeded and is no older than max(30s, 3 dispatch intervals); 0 otherwise.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "divegrade_scheduler_healthy{namespace=\"media\"}",
          "legendFormat": "Healthy",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Snapshot age",
      "type": "stat",
      "description": "Seconds since cached Kubernetes observation. Timestamp zero before first snapshot produces a large age.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - divegrade_snapshot_timestamp_seconds{namespace=\"media\"}",
          "legendFormat": "Snapshot age",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "title": "Occupied / maximum capacity",
      "type": "timeseries",
      "description": "Cached Kubernetes snapshot; check snapshot age. Occupied slots include admitted Jobs and terminating workers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "divegrade_occupied_slots{namespace=\"media\"}",
          "legendFormat": "Occupied",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "divegrade_concurrency_limit{namespace=\"media\"}",
          "legendFormat": "Maximum",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Retained jobs by state",
      "type": "timeseries",
      "description": "Cached Kubernetes snapshot; check snapshot age. Gauge of retained Kubernetes history, not a lifetime count; falls when Jobs/pods are removed or expire.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "divegrade_jobs{namespace=\"media\"}",
          "legendFormat": "{{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Queued admission reasons",
      "type": "timeseries",
      "description": "Cached Kubernetes snapshot; check snapshot age. Queued Jobs grouped by admission-blocking reason; current gauge, not a lifetime total.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "divegrade_queued_jobs{namespace=\"media\"}",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Oldest queued job age",
      "type": "timeseries",
      "description": "Cached Kubernetes snapshot; check snapshot age. Age since creation of oldest queued Job with a valid timestamp; zero when none.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "divegrade_queue_oldest_age_seconds{namespace=\"media\"}",
          "legendFormat": "Oldest queued job",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Active processing phases",
      "type": "timeseries",
      "description": "Cached Kubernetes snapshot; check snapshot age. Admitted running Jobs by last reported phase. No per-job metrics are exported; aggregate video frame metrics appear in Media progress. Phase can remain unchanged during long work.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 11,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "divegrade_active_jobs{namespace=\"media\"}",
          "legendFormat": "{{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Scheduler action rates",
      "type": "timeseries",
      "description": "Counter rate over 5 minutes; counters reset on dispatcher restart. Short events between scrapes may be missed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(divegrade_scheduler_actions_total{namespace=\"media\"}[5m])",
          "legendFormat": "{{action}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "Dispatch error / cycle rates",
      "type": "timeseries",
      "description": "Counter rate over 5 minutes; counters reset on dispatcher restart. Short events between scrapes may be missed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(divegrade_dispatch_errors_total{namespace=\"media\"}[5m])",
          "legendFormat": "Failed cycles",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "rate(divegrade_dispatch_cycles_total{namespace=\"media\"}[5m])",
          "legendFormat": "All cycles",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "Retained worker terminations",
      "type": "timeseries",
      "description": "Cached Kubernetes snapshot; check snapshot age. Gauge of retained Kubernetes history, not a lifetime count; falls when Jobs/pods are removed or expire. Includes OOMKilled; displayed directly, never as a counter or rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "divegrade_worker_terminations{namespace=\"media\"}",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "title": "Failed pod attempts / retry jobs",
      "type": "timeseries",
      "description": "Cached Kubernetes snapshot; check snapshot age. Gauge of retained Kubernetes history, not a lifetime count; falls when Jobs/pods are removed or expire. Failed attempts come from retained Job status; retries count retained Jobs created by explicit retry.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "divegrade_failed_pods{namespace=\"media\"}",
          "legendFormat": "Failed pod attempts",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "divegrade_retry_jobs{namespace=\"media\"}",
          "legendFormat": "Explicit retry jobs",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "Oldest heartbeat / progress age",
      "type": "timeseries",
      "description": "Cached Kubernetes snapshot; check snapshot age. Active Jobs with samples only; zero when none have samples. Heartbeats do not reset progress age. Long downloads/encodes can have old progress and fresh heartbeats.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "divegrade_worker_heartbeat_oldest_age_seconds{namespace=\"media\"}",
          "legendFormat": "Heartbeat",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "divegrade_worker_progress_oldest_age_seconds{namespace=\"media\"}",
          "legendFormat": "Progress",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "title": "Missing worker heartbeats",
      "type": "timeseries",
      "description": "Cached Kubernetes snapshot; check snapshot age. Admitted running Jobs with no heartbeat sample yet. Use alongside age panels: zero age alone does not prove freshness.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 25,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "divegrade_worker_heartbeat_missing{namespace=\"media\"}",
          "legendFormat": "No sample yet",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "title": "Reported active worker memory",
      "type": "timeseries",
      "description": "Sum of active Jobs\u2019 last reported current cgroup memory with samples at most 60s old. Best effort sampling every 5s and checkpoints includes children and charged file cache; stale/missing samples are omitted and final OOM spikes may be missed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 25,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "divegrade_worker_reported_memory_bytes{namespace=\"media\"}",
          "legendFormat": "Reported memory",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 17,
      "title": "Per-pod memory / requests / limits",
      "type": "timeseries",
      "description": "Existing container and kube-state metrics for media/dive-.* pods. Working set differs from total charged cgroup memory. Scrape sampling may miss peaks before OOM; retained pods can keep resource declarations after usage disappears.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (max by (pod, container) (container_memory_working_set_bytes{namespace=\"media\",pod=~\"dive-.*\",container!=\"\",container!=\"POD\"}))",
          "legendFormat": "{{pod}} working set",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum by (pod) (max by (pod, container) (kube_pod_container_resource_requests{namespace=\"media\",pod=~\"dive-.*\",resource=\"memory\",unit=\"byte\"}))",
          "legendFormat": "{{pod}} request",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "expr": "sum by (pod) (max by (pod, container) (kube_pod_container_resource_limits{namespace=\"media\",pod=~\"dive-.*\",resource=\"memory\",unit=\"byte\"}))",
          "legendFormat": "{{pod}} limit",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 18,
      "title": "Per-pod memory / limit",
      "type": "timeseries",
      "description": "Working set divided by declared memory limit; only positive limits. No data when usage/limit metrics are absent. Sampling can miss OOM peaks.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (max by (pod, container) (container_memory_working_set_bytes{namespace=\"media\",pod=~\"dive-.*\",container!=\"\",container!=\"POD\"})) / on (pod) (sum by (pod) (max by (pod, container) (kube_pod_container_resource_limits{namespace=\"media\",pod=~\"dive-.*\",resource=\"memory\",unit=\"byte\"})) > 0)",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 19,
      "title": "Per-pod CPU usage / requests",
      "type": "timeseries",
      "description": "CPU cores from existing container metrics averaged over 5m, with kube-state requests. Short-lived workers may lack enough samples; missing data is not zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
